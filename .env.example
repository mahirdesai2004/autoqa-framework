# AutoQA Environment Configuration Template
# Copy this file to .env and fill in your keys

# --- PRIMARY PROVIDER ---
GEMINI_API_KEY=your_primary_gemini_key_here

# Optional Gemini Key Rotation (Used if primary quota is exceeded)
GEMINI_API_KEY_1=your_backup_gemini_key_1
GEMINI_API_KEY_2=your_backup_gemini_key_2

# Optional Provider Configuration
# GEMINI_MODEL=gemini-2.5-flash


# --- FALLBACK PROVIDERS ---

# Mistral AI (Fallback Tier 1)
# MISTRAL_API_KEY=your_mistral_key_here
# MISTRAL_MODEL=mistral-large-latest

# Groq (Fallback Tier 2)
# GROQ_API_KEY=your_groq_key_here
# GROQ_MODEL=llama-3.3-70b-versatile
